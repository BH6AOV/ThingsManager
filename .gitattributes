# 换行符策略（跨平台仓库，务必显式声明，避免 Linux 包里的脚本被换成 CRLF）
# 规则：Linux 侧会被执行的脚本/配置 → 仓库内 LF；Windows 侧脚本 → 检出为 CRLF；二进制不转换
# 说明：index/提交里统一存 LF（除二进制），工作区按 eol 规则检出。

# —— 必须是 LF：进 deb/rpm/AppImage 的维护脚本、启动脚本、systemd unit、desktop、CI ——
*.sh        text eol=lf
*.bash      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.service   text eol=lf
*.desktop   text eol=lf
*.env       text eol=lf
*.spec.in   text eol=lf
*.in        text eol=lf
AppRun      text eol=lf
control     text eol=lf
conffiles   text eol=lf
postinst    text eol=lf
prerm       text eol=lf
postrm      text eol=lf

# —— Windows 侧：保持 CRLF 检出 ——
*.ps1       text eol=crlf
*.iss       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# —— 二进制：不做任何转换 ——
*.ico       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.xlsx      binary
*.db        binary
