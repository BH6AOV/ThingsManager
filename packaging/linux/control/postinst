#!/bin/sh
# ThingsManager 安装后脚本：建服务账号 / 建数据目录 / 初始化运行配置 / 启用并启动 systemd 服务
set -e

# ---------- 1) 服务账号（系统用户，无登录 shell） ----------
if ! getent group thingsmanager >/dev/null 2>&1; then
    addgroup --system thingsmanager >/dev/null 2>&1 || groupadd -r thingsmanager
fi
if ! getent passwd thingsmanager >/dev/null 2>&1; then
    adduser --system --ingroup thingsmanager --home /var/lib/thingsmanager \
            --no-create-home --shell /usr/sbin/nologin thingsmanager >/dev/null 2>&1 \
      || useradd -r -g thingsmanager -d /var/lib/thingsmanager -s /usr/sbin/nologin thingsmanager
fi

# ---------- 2) 数据目录（默认 /var/lib/thingsmanager） ----------
mkdir -p /var/lib/thingsmanager
chown thingsmanager:thingsmanager /var/lib/thingsmanager
chmod 0750 /var/lib/thingsmanager

# 运行配置：程序目录只读，配置放在可写的数据目录里（THM_CONFIG 指向它）
# 首次安装写入默认数据目录；升级 / 重装不覆盖已有配置（保留用户改过的目录与监听设置）
if [ ! -f /var/lib/thingsmanager/runtime.config.json ]; then
    printf '%s\n' '{"dataDir":"/var/lib/thingsmanager"}' > /var/lib/thingsmanager/runtime.config.json
fi
chown thingsmanager:thingsmanager /var/lib/thingsmanager/runtime.config.json 2>/dev/null || true
chmod 0640 /var/lib/thingsmanager/runtime.config.json 2>/dev/null || true

# ---------- 3) systemd：启用并启动服务 ----------
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable thingsmanager >/dev/null 2>&1 || true
    systemctl restart thingsmanager >/dev/null 2>&1 || true
fi

cat <<'EOF'

ThingsManager 服务端已安装：
  面板地址 : http://<本机IP>:3200        （默认监听 0.0.0.0:3200，可在 设置 → 桌面/网络 修改）
  数据目录 : /var/lib/thingsmanager      （运行配置 /var/lib/thingsmanager/runtime.config.json）
  服务管理 : systemctl status|start|stop|restart thingsmanager
  实时日志 : journalctl -u thingsmanager -f
  开机自启 : systemctl enable thingsmanager / disable thingsmanager

EOF

exit 0
