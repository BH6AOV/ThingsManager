[Unit]
Description=ThingsManager · 轻量仓库管理（服务端）
Documentation=https://github.com/BH6AOV
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=thingsmanager
Group=thingsmanager
WorkingDirectory=/opt/thingsmanager/app


EnvironmentFile=-/etc/thingsmanager/thingsmanager.env

Environment=THM_CONFIG=/var/lib/thingsmanager/runtime.config.json

Environment=THM_DESKTOP=1
Environment=NODE_ENV=production

ExecStart=/opt/thingsmanager/runtime/bin/node /opt/thingsmanager/app/server.js


Restart=always
RestartSec=1
KillSignal=SIGTERM
TimeoutStopSec=15

StandardOutput=journal
StandardError=journal
SyslogIdentifier=thingsmanager


NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true


LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
